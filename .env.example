# ============================================================
#  WhatsApp Chat Viewer — configuration (.env)
#  Copiez ce fichier en ".env" et remplissez les valeurs.
# ============================================================

# ----------------------------------------------------------
# Option A : pointer vers une archive .zip exportée par WhatsApp
# Le script extrait l'archive et détecte automatiquement le .txt et les médias
# ----------------------------------------------------------
# ZIP_FILE=/chemin/vers/WhatsApp_Chat.zip
# EXTRACT_DIR=/chemin/vers/dossier_extraction  # Optionnel (défaut : dossier au nom du zip)

# ----------------------------------------------------------
# Option B : pointer vers un dossier d'export WhatsApp décompressé
# Le script trouve automatiquement le .txt et le sous-dossier media/
# ----------------------------------------------------------
# CHAT_DIR=/chemin/vers/export_whatsapp

# ----------------------------------------------------------
# Option C : spécifier les chemins manuellement
# ----------------------------------------------------------
# CHAT_FILE=/chemin/vers/chat.txt
# MEDIA_DIR=/chemin/vers/media

# ----------------------------------------------------------
# Fichier HTML de sortie (optionnel, défaut : output.html dans le CWD)
# ----------------------------------------------------------
# OUTPUT_FILE=/chemin/vers/output.html

# ----------------------------------------------------------
# Interlocuteur "Moi" (optionnel, bulles à droite sur fond vert WhatsApp)
# ----------------------------------------------------------
# ME=Mon Nom
# YOUR_NAME=Mon Nom

# ----------------------------------------------------------
# Sécurité archives ZIP (Protection contre les bombes ZIP / DoS)
# ----------------------------------------------------------
# MAX_UNCOMPRESSED_SIZE=10737418240  # Taille max décompressée en octets (défaut : 10 Go)
# MAX_ZIP_FILES=50000                # Nombre max de fichiers dans le ZIP (défaut : 50 000)
# MAX_COMPRESSION_RATIO=100.0        # Ratio max décompressé/compressé pour gros fichiers (défaut : 100)

# ZIP_CHECK_OVERLAP=0                # Vérification chevauchement physique des données ZIP (défaut : désactivé)
#                                    # Mettre à 1 pour activer (déconseillé pour archives WhatsApp légitimes)

