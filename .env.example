# ============================================================
#  WhatsApp Chat Viewer — configuration (.env)
#  Copiez ce fichier en ".env" et remplissez les valeurs.
# ============================================================

# ----------------------------------------------------------
# Option A : pointer vers un dossier d'export WhatsApp entier
# Le script trouve automatiquement le .txt et le sous-dossier media/
# ----------------------------------------------------------
# CHAT_DIR=/chemin/vers/export_whatsapp

# ----------------------------------------------------------
# Option B : spécifier les chemins manuellement
# ----------------------------------------------------------
# CHAT_FILE=/chemin/vers/chat.txt
# MEDIA_DIR=/chemin/vers/media

# ----------------------------------------------------------
# Fichier HTML de sortie (optionnel, défaut : output.html dans le CWD)
# ----------------------------------------------------------
# OUTPUT_FILE=/chemin/vers/output.html

# ----------------------------------------------------------
# Interlocuteur "Moi" (optionnel, bulles à droite sur fond vert WhatsApp)
# ----------------------------------------------------------
# ME=Mon Nom
# YOUR_NAME=Mon Nom

